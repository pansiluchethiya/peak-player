# API server (peak-embed-platform) that serves embed sessions and streams
NEXT_PUBLIC_API_URL=http://localhost:8787

# Peak player origin (serves peak-embed.js SDK)
NEXT_PUBLIC_PLAYER_URL=http://localhost:3011

# Partner API key for creating embed sessions. Must match an entry in the API
# server's EMBED_PARTNERS. The browser never sees this value: session creation
# is proxied through /api/embed/session.
EMBED_PARTNER_API_KEY=demo-key-change-me

# Default media to play (TMDB id). 550 = Fight Club.
NEXT_PUBLIC_DEFAULT_MEDIA_TYPE=movie
NEXT_PUBLIC_DEFAULT_MEDIA_ID=550
