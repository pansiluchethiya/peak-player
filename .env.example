# Peak configuration
TMDB_API_KEY=your_tmdb_api_key
# Optional: JSON array for multi-key rotation
# TMDB_API_KEYS=["key1","key2"]
# Optional: server port (defaults to 8787)
# API_PORT=8787
# Optional: player port (defaults to 3001)
# PLAYER_PORT=3001

# Public browser-facing URLs. These are not container-internal hostnames.
# PLAYER_PUBLIC_URL is required in production.
PLAYER_PUBLIC_URL=http://localhost:3001
PUBLIC_API_URL=http://localhost:8787
# Comma-separated origins allowed to call the media proxy.
PLAYER_ALLOWED_ORIGINS=http://localhost:3001

# Secrets: replace both with long random values before exposing the stack.
EMBED_TOKEN_SECRET=replace-with-a-long-random-secret
PROXY_SIGNING_SECRET=replace-with-a-long-random-secret

# Embed partners. Each partner gets an API key and one or more exact origins.
# Wildcard origins are rejected. Keep this JSON on one line in .env.
# EMBED_PARTNERS=[{"id":"demo","name":"Demo Partner","apiKey":"replace-with-a-long-api-key","origins":["https://partner.example"]}]

# Demo page session minting. EMBED_DEMO_API_KEY must match a partner apiKey.
# EMBED_DEMO_API_KEY=replace-with-a-long-api-key
# EMBED_DEMO_TMDB_ID=550
# Optional sandboxed fallback for third-party HTML5 sources. Off by default.
# NEXT_PUBLIC_ALLOW_THIRD_PARTY_EMBED=0

# Docs URL — tells the UI where to find documentation (for "Learn more" links).
# Optional. Defaults to https://docs.peak-player.com.
# PEAK_DOCS_URL=https://docs.peak-player.com
# NEXT_PUBLIC_DOCS_URL — build-time version for the player client bundle.
# If only PEAK_DOCS_URL is set, the player fetches /api/docs-url at runtime.
# NEXT_PUBLIC_DOCS_URL=https://docs.peak-player.com

# Febbox cookies for streaming (febbox.com / febbox.site)
# Can be a comma-separated list for multiple cookies:
# FEBBOX_COOKIES=your_cookie1,your_cookie2,your_cookie3
# Or a JSON array:
# FEBBOX_COOKIES=["cookie1","cookie2"]